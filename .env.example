# PostgreSQL (PostGIS)
POSTGRES_USER=minimani
POSTGRES_PASSWORD=minimani_secret
POSTGRES_DB=minimani_db
DB_HOST=localhost
DB_PORT=5438
DATABASE_URL=postgres://minimani:minimani_secret@localhost:5438/minimani_db?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6385
REDIS_URL=redis://localhost:6385/0

# Backend Server
PORT=8088
ENV=development
ALLOWED_ORIGINS=http://localhost:5185,http://localhost:5173

# Media Storage
MEDIA_DIR=./media

# Hetzner S3 Object Storage
S3_ENDPOINT=hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=minimani
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key


